// Schema Prisma — TASK-01 (fundação, sem IA).
// Nomes físicos em inglês snake_case (@map/@@map); soft delete via deletedAt.
// Campos de classificação por IA (categoria/prioridade/area/sentimento/resumo),
// atribuição e histórico entram na Sprint-2. Ver plan-build/spec.md e Sprint-1.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ponytail: Perfil e seus literais são contrato de RBAC (JWT/guard/testes), não naming de schema.
// Mantidos em pt-BR de propósito; traduzir p/ Role é refactor de auth (escopo separado).
enum Perfil {
  CLIENTE
  FUNCIONARIO
  ADMIN
}

enum TicketStatus {
  AWAITING_CLASSIFICATION
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  perfil       Perfil
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  // Mesma entidade User faz os dois papéis: quem abre e quem atende.
  ticketsCreated  Ticket[] @relation("TicketAuthor")
  ticketsAssigned Ticket[] @relation("TicketAssignee")

  @@map("users")
}

model Ticket {
  id        Int          @id @default(autoincrement())
  body      String
  status    TicketStatus @default(AWAITING_CLASSIFICATION)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(3)

  authorId Int  @map("author_id")
  author   User @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  // Atribuição a funcionário é RF-07 (Sprint-2); nasce nulo na v1 desta sprint.
  assigneeId Int?  @map("assignee_id")
  assignee   User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([assigneeId])
  @@index([status])
  @@map("tickets")
}
