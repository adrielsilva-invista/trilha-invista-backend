// Schema Prisma — TASK-01 (fundação) + TASK-07 (classificação IA + histórico, Sprint-2).
// Nomes físicos em inglês snake_case (@map/@@map); soft delete via deletedAt.
// Classificação: colunas original_* (IA, imutável) + final_* (editável) direto no Ticket
// (squad-vote 2026-08-11_001, opção A). Histórico append-only em TicketEvent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ponytail: Perfil e seus literais são contrato de RBAC (JWT/guard/testes), não naming de schema.
// Mantidos em pt-BR de propósito; traduzir p/ Role é refactor de auth (escopo separado).
enum Perfil {
  CLIENTE
  FUNCIONARIO
  ADMIN
}

enum TicketStatus {
  AWAITING_CLASSIFICATION
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

// Enums de classificação (RF-04). Nome do TIPO em inglês (padrão físico do schema);
// os VALORES ficam em pt-BR de propósito = contrato com a IA (tool use) e a métrica de
// concordância; semântica de cada valor vem do Anexo A (B-01, não bloqueia o schema).
enum Category {
  PROBLEMA_TECNICO
  DUVIDA
  RECLAMACAO
  SOLICITACAO
  OUTROS
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum Area {
  ENGENHARIA
  QUALIDADE
  LOGISTICA
  COMERCIAL
  SUPORTE_TECNICO
  OUTROS
}

enum Sentiment {
  POSITIVO
  NEUTRO
  NEGATIVO
  FRUSTRADO
}

// Tipos de evento do histórico append-only (RF-11).
enum TicketEventType {
  CLASSIFICACAO_IA
  FALHA_CLASSIFICACAO
  RECLASSIFICACAO
  ATRIBUICAO
  MUDANCA_STATUS
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  perfil       Perfil
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  // Mesma entidade User faz os dois papéis: quem abre e quem atende.
  ticketsCreated  Ticket[] @relation("TicketAuthor")
  ticketsAssigned Ticket[] @relation("TicketAssignee")

  @@map("users")
}

model Ticket {
  id        Int          @id @default(autoincrement())
  body      String
  status    TicketStatus @default(AWAITING_CLASSIFICATION)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(3)

  authorId Int  @map("author_id")
  author   User @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  // Atribuição a funcionário (RF-07); nasce nulo, worker/funcionário preenche na Sprint-2.
  assigneeId Int?  @map("assignee_id")
  assignee   User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Classificação (RF-04). Nullable: chamado nasce sem classificação. Caminho manual (RF-05)
  // preenche os final_* sem original_*. IMUTABILIDADE da original é invariante de APLICAÇÃO
  // (Postgres não a impõe sem trigger) — garantida no use case + teste, não no schema.
  // ponytail: sem trigger de imutabilidade; se o dado real exigir, subir p/ constraint/trigger.
  needsManualClassification Boolean @default(false) @map("needs_manual_classification")

  originalCategory  Category?  @map("original_category")
  originalPriority  Priority?  @map("original_priority")
  originalArea      Area?      @map("original_area")
  originalSentiment Sentiment? @map("original_sentiment")

  finalCategory  Category?  @map("final_category")
  finalPriority  Priority?  @map("final_priority")
  finalArea      Area?      @map("final_area")
  finalSentiment Sentiment? @map("final_sentiment")

  // summary é read-only (só a IA escreve, RF-04); modelo/versão para tracing (RF-11).
  summary   String? @db.VarChar(300)
  aiModel   String? @map("ai_model")
  aiVersion String? @map("ai_version")

  events TicketEvent[]

  @@index([authorId])
  @@index([assigneeId])
  @@index([status])
  @@map("tickets")
}

// Trilha imutável de eventos por chamado (RF-11). Append-only: o repositório (TASK-08)
// só expõe create/read — nunca update/delete, é o que garante a imutabilidade.
// payload guarda o específico de cada tipo (antes→depois, tentativa, critério, campos da IA).
model TicketEvent {
  id        Int             @id @default(autoincrement())
  ticketId  Int             @map("ticket_id")
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      TicketEventType
  payload   Json
  // Autor da ação: id do funcionário, ou null quando é o sistema (classificação/atribuição automática).
  authorId  Int?            @map("author_id")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}
