# Copie para .env (não commitado) e ajuste os valores.

# Postgres (sobe via docker-compose: service `postgres`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trilha_invista?schema=public"

# Auth (TASK-02)
JWT_SECRET="troque-por-um-segredo-forte"

# HTTP (opcional, default 3000)
PORT=3000

# Fila de classificação (TASK-09: BullMQ; sobe via docker-compose service `redis`)
REDIS_URL="redis://localhost:6379"

# Classificador Claude (TASK-10). A chave REAL vai só no .env local — nunca aqui.
ANTHROPIC_API_KEY="sk-ant-api03-COLOQUE-A-SUA-CHAVE-NO-.env-LOCAL"
ANTHROPIC_TIMEOUT_MS=30000
